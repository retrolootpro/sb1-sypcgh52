# Self-hosted production example
#
# NEXT_PUBLIC_SUPABASE_URL should point at your self-hosted Supabase API gateway.
# If you put IIS/HTTPS in front of Supabase, use that HTTPS URL.
# If Supabase is internal only, use the internal LAN URL reachable by the Next app.
NEXT_PUBLIC_SUPABASE_URL=https://api.yourdomain.com
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-self-hosted-anon-key

