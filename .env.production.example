# Production environment
# Do not copy development values here.
# Add these values in Netlify under Site configuration > Environment variables.
NEXT_PUBLIC_SUPABASE_URL=https://your-prod-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-prod-anon-key

# Server-only storefront catalog and commerce access. Never use NEXT_PUBLIC_ for this key.
SUPABASE_SERVICE_ROLE_KEY=

# Shipping-only Stripe Checkout and emailed invoices. Start with Stripe test mode.
# Configure these securely in Netlify, not in source control.
STOREFRONT_SITE_URL=https://your-production-domain.netlify.app
# Production stays closed even when Stripe test credentials are added.
STOREFRONT_PAYMENTS_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Comma-separated active USD fixed-amount shipping rate IDs from the same Stripe mode.
STRIPE_SHIPPING_RATE_IDS=
# Comma-separated supported country codes matching your fulfillment regions.
STRIPE_SHIPPING_COUNTRIES=
# Keep false until test-mode checkout, invoices, and webhook reconciliation pass.
STRIPE_LIVE_PAYMENTS_ENABLED=false

# Optional. Add these in Netlify if you want natural-language AI responses.
# Leave unset to use calculated inventory analysis only.
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4.1-mini
